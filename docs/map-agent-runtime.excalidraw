    { "type": "text", "id": "note", "x": 40, "y": 1020, "width": 1640, "height": 60, "text": "Agent, not pipeline — the control-flow graph is drawn at RUNTIME by the model (resolve → area → map, or ask to disambiguate, or decline),\nnot authored ahead like the ETL DAG. Autonomy is clamped hard (read-only · typed · budgeted): the deploy tax on an agent, not proof it isn't one.", "originalText": "Agent, not pipeline — the control-flow graph is drawn at RUNTIME by the model (resolve → area → map, or ask to disambiguate, or decline),\nnot authored ahead like the ETL DAG. Autonomy is clamped hard (read-only · typed · budgeted): the deploy tax on an agent, not proof it isn't one.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#475569", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 1602, "version": 1, "versionNonce": 92, "isDeleted": false, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "link": null, "locked": false, "containerId": null, "lineHeight": 1.4 }
