    { "type": "text", "id": "maph", "x": 970, "y": 424, "width": 400, "height": 24, "text": "Map policy  (the new agent)", "originalText": "Map policy  (the new agent)", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 1312, "version": 1, "versionNonce": 55, "isDeleted": false, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
