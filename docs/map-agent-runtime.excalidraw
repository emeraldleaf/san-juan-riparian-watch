    { "type": "text", "id": "doch", "x": 110, "y": 424, "width": 400, "height": 24, "text": "Document policy  (the incumbent)", "originalText": "Document policy  (the incumbent)", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 1302, "version": 1, "versionNonce": 52, "isDeleted": false, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
