    { "type": "text", "id": "seamt", "x": 510, "y": 276, "width": 420, "height": 76, "text": "THE SEAM · model → geometry\nThe model CHOOSES the place; the resolver\nPRODUCES the geometry — or returns it\nunresolved. Never coordinates from the model.", "originalText": "THE SEAM · model → geometry\nThe model CHOOSES the place; the resolver\nPRODUCES the geometry — or returns it\nunresolved. Never coordinates from the model.", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#92400e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 1202, "version": 1, "versionNonce": 42, "isDeleted": false, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "link": null, "locked": false, "containerId": "seam", "lineHeight": 1.25 },
