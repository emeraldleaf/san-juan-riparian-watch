      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "Only the public repo can compute WHAT changed \u2014 it has the docs and the history.\nOnly the harness can APPLY it \u2014 it has the index and the embedder.\nNeither side can do the other's half, so the delta is the seam between them.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only the public repo can compute WHAT changed \u2014 it has the docs and the history.\nOnly the harness can APPLY it \u2014 it has the index and the embedder.\nNeither side can do the other's half, so the delta is the seam between them.",
      "lineHeight": 1.25
    }
