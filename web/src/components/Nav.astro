---
// Shared top navigation, used on every page so nav + theme control are the same
// everywhere. The primary CTA ("Ask the map") is hidden on the page it points to.
// The #tog button is wired + persisted by the shared script in Base.astro.
interface Props { current?: string }
const { current } = Astro.props;
---
<div class="topbar"><div class="wrap">
  <a class="brand" href="/"><span class="dot"></span> San Juan Riparian Watch</a>
  <nav class="topnav">
    <a href="/method">Method</a>
    <a href="/architecture">Architecture</a>
    <a class="cta ghost" href="/#agent">Ask the agent</a>
    {current !== 'map' && <a class="cta" href="/map">Ask the map <span class="arw" aria-hidden="true">→</span></a>}
    <button class="tog" id="tog" aria-label="Toggle light or dark theme">◐</button>
  </nav>
</div></div>
